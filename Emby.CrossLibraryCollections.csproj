<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Emby.CrossLibraryCollections</AssemblyName>
    <RootNamespace>Emby.CrossLibraryCollections</RootNamespace>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <PackageVersion>1.1.0</PackageVersion>
    <Description>Emby plugin to automatically aggregate movies and TV series of the same franchise into unified cross-library collections.</Description>
    <Authors>Imagine-Breaker</Authors>
    <RepositoryUrl>https://github.com/Imagine-Breaker/Emby.CrossLibraryCollections</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="MediaBrowser.Common" Version="4.8.11" />
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.8.11" />
  </ItemGroup>

</Project>
